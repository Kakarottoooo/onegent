# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/worker/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.gstack/

# Claude Code local settings (machine-specific permissions)
.claude/settings.local.json
# Booking autopilot saved cookies (sensitive — never commit)
.booking-cookies/
.booking-cookies.json
.ticketmaster-cookies.json
# Local-only notes / secrets ledger (OAuth client_secrets, etc.)
*.local.md
.seatgeek-cookies.json

# Real Chrome persistent profile (opt-in via USE_REAL_CHROME_FOR)
.chrome-profile-autopilot/

# Dev artifacts
.next-dev.log
.playwright-cli/
benchmark/runs/*.json
benchmark/runs/*.md
benchmark/runs/founder-e2e-assets/
.claude/worktrees/
.context/
.debug-screenshots/
.ralph-src/
.ship/
.claude/skills/gstack/
dev.log
dev.log~
phase1-dev.log
scripts/ralph/.last-branch
# Local QA evidence (never commit; per-attempt timestamped logs)
logs/
.stage0b-evidence/
worker.log
