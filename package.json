{
  "name": "restaurant-agent",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run build:mcp",
    "build": "next build --webpack",
    "postbuild": "node scripts/inject-sw-version.mjs",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "build:mcp": "npm run build -w @onegent/mcp-server",
    "check-drift": "npx tsx scripts/check-drift.ts",
    "smoke:phase1": "node scripts/smoke-phase1.mjs",
    "preflight:founder-e2e": "node scripts/founder-e2e-preflight.mjs",
    "e2e:founder": "npx tsx scripts/run-founder-e2e.ts",
    "e2e:founder:headed": "npx tsx scripts/run-founder-e2e.ts --headed",
    "e2e:founder:json": "npx tsx scripts/run-founder-e2e.ts --json",
    "probe:resy": "npx tsx scripts/probe-resy-availability.ts",
    "gate:phase1": "npx tsx scripts/run-phase1-quality-gate.ts",
    "gate:phase1:json": "npx tsx scripts/run-phase1-quality-gate.ts --json"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.79.0",
    "@browserbasehq/stagehand": "^3.2.0",
    "@clerk/nextjs": "^7.0.5",
    "@types/leaflet": "^1.9.21",
    "@vercel/postgres": "^0.10.0",
    "leaflet": "^1.9.4",
    "next": "16.1.7",
    "next-mdx-remote": "^6.0.0",
    "oslo": "^1.2.1",
    "playwright": "^1.58.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-leaflet": "^5.0.0",
    "recharts": "^3.8.1",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "stripe": "^22.1.0",
    "web-push": "^3.6.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.0",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.7",
    "jsdom": "^29.0.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.0"
  }
}
