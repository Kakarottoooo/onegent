{
  "name": "@onegent/mcp-server",
  "version": "0.1.1",
  "description": "Travel execution layer for AI agents — book restaurants, hotels, flights, and activities through an AI agent that navigates real booking sites.",
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "ai-agent",
    "travel",
    "booking",
    "restaurant",
    "hotel",
    "flight",
    "onegent"
  ],
  "license": "MIT",
  "author": "Onegent",
  "homepage": "https://onegent.one/developers/docs/integrations/claude-mcp",
  "bugs": {
    "url": "mailto:support@onegent.one"
  },
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server-factory": {
      "types": "./dist/server-factory.d.ts",
      "default": "./dist/server-factory.js"
    },
    "./api-client": {
      "types": "./dist/api-client.d.ts",
      "default": "./dist/api-client.js"
    },
    "./http-server": {
      "types": "./dist/http-server.d.ts",
      "default": "./dist/http-server.js"
    },
    "./tools/*": {
      "types": "./dist/tools/*.d.ts",
      "default": "./dist/tools/*.js"
    }
  },
  "bin": {
    "onegent-mcp-server": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "start": "node ./dist/index.js",
    "dev": "tsc --watch"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^20",
    "typescript": "^5"
  }
}
